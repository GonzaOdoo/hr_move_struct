<odoo>
    <record id="hr_payroll_structure_form_additional_accounting"
            model="ir.ui.view">
        <field name="name">
            hr.payroll.structure.form.additional.accounting
        </field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id"
               ref="hr_payroll.view_hr_employee_grade_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]" position="after">
                <group string="Concepto contable adicional">
                    <field name="additional_percentage"/>
                    <field name="additional_debit_account_id"/>
                    <field name="additional_credit_account_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>